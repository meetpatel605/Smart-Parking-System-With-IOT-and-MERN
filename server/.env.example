PORT=5252
MONGO_URI=mongodb://127.0.0.1:27017/smart_parking
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional SMTP settings. When configured, forgot-password sends the OTP by email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@smartparking.com

# Default admin account created by "npm run seed"
ADMIN_EMAIL=admin@smartparking.com
ADMIN_PASSWORD=Admin@123
