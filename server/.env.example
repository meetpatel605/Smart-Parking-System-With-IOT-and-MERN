PORT=5252
MONGO_URI=mongodb://127.0.0.1:27017/smart_parking
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# MQTT hardware integration (development broker; use private TLS credentials in production)
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-parking-backend
MQTT_TLS_REJECT_UNAUTHORIZED=false
DEVICE_OFFLINE_AFTER_MS=120000
PARKING_TIMEZONE=Asia/Kolkata

# Optional SMTP settings. When configured, forgot-password sends the OTP by email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@smartparking.com

# Default admin account created by "npm run seed"
ADMIN_EMAIL=admin@smartparking.com
ADMIN_PASSWORD=Admin@123
